# ==========================================================================
# BaturPay API configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ==========================================================================

# Runtime mode: sandbox | production.
# In sandbox, all money movement is simulated. In production, live operations
# remain BLOCKED until an operator explicitly enables them (see GO_LIVE).
BATURPAY_MODE=sandbox
NODE_ENV=development

# HTTP
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000

# Postgres
DATABASE_URL=postgres://baturpay:baturpay@localhost:5432/baturpay
PGSSLMODE=disable

# Auth / crypto
# 32+ random bytes, base64. Generate: openssl rand -base64 32
API_KEY_PEPPER=change-me-development-only-pepper
WEBHOOK_SIGNING_SECRET=change-me-development-only-webhook-secret
SESSION_JWT_SECRET=change-me-development-only-session-secret

# Webhook delivery lab
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
WEBHOOK_EGRESS_ALLOWLIST=localhost,127.0.0.1

# Rate limiting
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Go-live gate. Live (real-money) operations require ALL of the following:
#   1. BATURPAY_MODE=production
#   2. LIVE_PAYMENTS_ENABLED=true
#   3. GO_LIVE_ATTESTATION set to a signed approval reference issued through the
#      compliance process (partner agreement + licensing reviewed).
# Without all three, any live operation fails closed with LiveOperationBlocked.
# ---------------------------------------------------------------------------
LIVE_PAYMENTS_ENABLED=false
GO_LIVE_ATTESTATION=

# Provider adapters. No live adapter ships in this build. Sandbox adapters only.
PROVIDER_SANDBOX_ENABLED=true
PROVIDER_LIVE_ENABLED=false
